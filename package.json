{
  "name": "opencode-studio",
  "version": "2.2.3",
  "description": "OpenCode Studio — 内置官方原生 Claude Code 的全平台开箱即用工作台（随安装包自带原生 Claude Code、零代理直连内置多 API、官方完整 OAuth 登录、国内直连/代理双引擎全网商店、自定义无边框对话框与高清/动态壁纸）",
  "type": "module",
  "main": "electron/main.mjs",
  "author": "gniygniynus <gniygniynus@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gniygniynus/opencode-studio.git"
  },
  "homepage": "https://github.com/gniygniynus/opencode-studio",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "desktop": "electron .",
    "test": "node --test tests/*.test.mjs",
    "build:win": "electron-builder --win nsis portable --publish never",
    "build:mac": "electron-builder --mac dmg zip --publish never",
    "build:linux": "electron-builder --linux AppImage deb --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.323",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^36.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.opencode.studio",
    "productName": "OpenCode Studio",
    "electronVersion": "36.2.0",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "OpenCode Studio.bat",
      "package.json",
      "LICENSE",
      "README.md",
      "!node_modules/@anthropic-ai/claude-code/bin/claude*"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/**",
      "server/**"
    ],
    "extraMetadata": {
      "main": "electron/main.mjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
